# AI PRONOTE 환경 변수 — 이 파일을 .env.local 로 복사해 값을 채웁니다.
# .env.local 은 저장소에 올라가지 않습니다(.gitignore).

# ── 인증 ──────────────────────────────────────────────────────────
# 이 PC에서 혼자 쓸 때 = true (로그인 없이 바로 사용)
# 여러 사람이 쓸 때 = false 로 두고 아래 Supabase 값을 채웁니다.
BYPASS_AUTH=false

# BYPASS_AUTH=false 일 때만 필요
SUPABASE_URL=
SUPABASE_ANON_KEY=
OAUTH_ENABLED=false

# ── 화자 분리 (선택) ──────────────────────────────────────────────
# 누가 말했는지 나누는 기능. 없으면 이 기능만 꺼진 채 나머지는 정상 동작합니다.
# huggingface.co 에서 토큰 발급 후 입력
HF_TOKEN=

# ── AI 회의록 ─────────────────────────────────────────────────────
# 별도 키가 필요 없습니다. 이 PC의 claude 로그인을 그대로 씁니다(추가 비용 없음).
